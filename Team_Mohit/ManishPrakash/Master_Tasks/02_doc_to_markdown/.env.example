# Copy to .env and fill in. Never commit the real file.

# --- AnythingLLM (required only for `docmd ingest` and `docmd check`) ---
# Inside Docker Compose use the service name, not localhost.
ANYTHINGLLM_BASE_URL=http://localhost:3001
# AnythingLLM -> Settings -> API Keys -> Generate
ANYTHINGLLM_API_KEY=
# Workspace slug the documents are embedded into. Must already exist.
ANYTHINGLLM_WORKSPACE=research

# --- Conversion (all optional; CLI flags override these) ---
DOCMD_INPUT_DIR=input
DOCMD_OUTPUT_DIR=output
# auto | markitdown | docling | plaintext
DOCMD_ENGINE=auto
DOCMD_RECURSIVE=true
DOCMD_OVERWRITE=false
DOCMD_MAX_BYTES=52428800
